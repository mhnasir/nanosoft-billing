@echo off
rem ============================================================
rem  Export the NVS2026 data from SQL Server to plain files (bcp).
rem  Run this on the PC that has SQL Server. Output goes to the "migrate" folder
rem  next to this file. Then run:  npm run import
rem ============================================================
setlocal
cd /d "%~dp0"
set "SRV=.\SQLEXPRESS"
set "DB=NVS2026"
set /p SRV=SQL Server instance [%SRV%]: 
set /p DB=Database [%DB%]: 
echo Leave the password empty to use your Windows login instead of "sa".
set "PW="
set /p PW=sa password: 
if "%PW%"=="" ( set "AUTH=-T" ) else ( set "AUTH=-U sa -P %PW%" )

set "BCP=bcp"
where bcp >nul 2>nul || set "BCP=C:\Program Files (x86)\Microsoft SQL Server\90\Tools\Binn\bcp.exe"
if not exist migrate mkdir migrate
del /q migrate\*.dat 2>nul
set "FAIL=0"

