# Copy to .env (setup.cmd does this for you and generates JWT_SECRET)

PORT=3000

# --- PostgreSQL ---
# Defaults match docker-compose.yml (Postgres container published on 127.0.0.1:5434).
# For a normal Windows PostgreSQL install use PG_PORT=5432 and your own password.
PG_HOST=localhost
PG_PORT=5434
PG_DATABASE=nvs
PG_USER=postgres
PG_PASSWORD=nvs_dev_password
# Or use one connection string instead of the PG_* values above:
# DATABASE_URL=postgres://user:password@localhost:5432/nvs

# --- Auth ---
# Random string used to sign login tokens (generated by setup.cmd).
JWT_SECRET=
# Hours a login stays valid
TOKEN_HOURS=12
